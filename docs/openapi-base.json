          "200": {
            "description": "The rendered mail, under a strict Content-Security-Policy. ?locale=en|is picks the language; ?format=text answers the plain-text part as text/plain.",
            "headers": { "x-correlation-id": { "schema": { "type": "string", "format": "uuid" } } },
            "content": {
              "text/html": { "schema": { "type": "string" } },
              "text/plain": { "schema": { "type": "string" } }
            }
          }
        }
      }
    },
    "/api/v1/internal/communications/{id}/audience": {
      "get": {
        "operationId": "communicationAudienceEstimate",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/internal/communications/{id}/test": {
      "post": {
        "operationId": "testSendCommunication",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/internal/communications/{id}/send": {
      "post": {
        "operationId": "sendCommunication",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/internal/communications/{id}/cancel": {
      "post": {
        "operationId": "cancelCommunication",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/internal/communications/{id}/deliveries": {
      "get": {
        "operationId": "listCommunicationDeliveries",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "/api/v1/internal/communications/{id}/deliveries/retry": {
      "post": {
        "operationId": "retryCommunicationDeliveries",
        "responses": { "200": { "$ref": "#/components/responses/Ok" } }
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "PublicId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 8, "maxLength": 100 }
      }
    },
    "responses": {
      "Ok": {
        "description": "Successful organization-scoped response",
        "headers": {
          "x-correlation-id": {
            "schema": { "type": "string", "format": "uuid" }
          }
        }
      },
      "Error": {
        "description": "Machine-readable, user-safe error response",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    },
    "schemas": {
      "CommunicationSettingsResponse": {
        "type": "object",
        "required": ["item", "status"],
        "properties": {
          "item": { "$ref": "#/components/schemas/communicationSettingsInputSchema" },
          "status": {
            "type": "object",
            "required": ["providerConfigured", "webhookConfigured", "webhookUrl", "effectiveSendingState"],
            "properties": {
              "providerConfigured": { "type": "boolean", "description": "SENDGRID_API_KEY is set." },
              "webhookConfigured": { "type": "boolean", "description": "SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY is set." },
              "webhookUrl": { "type": "string", "format": "uri", "description": "The URL to enter in SendGrid's Event Webhook settings." },
              "effectiveSendingState": {
                "type": "string",
                "enum": ["disabled", "provider-missing", "sandbox", "safe-mode", "live"],
                "description": "What the worker would do now: disabled (the switch is off), provider-missing (on, but no API key), sandbox (SendGrid validates and delivers nothing), safe-mode (only allow-listed domains), live."
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message", "correlationId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "correlationId": { "type": "string", "format": "uuid" }
            }
          }
        }
      }
    }
  }
}
